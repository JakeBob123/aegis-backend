# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/security_platform

# --- Discord OAuth2 (from the Discord Developer Portal) ---
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret      # NEVER sent to frontend
DISCORD_OAUTH_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# --- Discord bot token, used only for backend->Discord REST calls that
#     verify guild membership/permissions server-side (not for gateway) ---
DISCORD_BOT_TOKEN=your_bot_token              # NEVER sent to frontend

# --- Sessions ---
JWT_SIGNING_SECRET=change_me_to_a_long_random_string   # NEVER sent to frontend
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Bot <-> backend internal channel (now path-routed on the same port
#     as everything else — see /internal-ws in src/ws/server.js) ---
INTERNAL_WS_SHARED_SECRET=change_me_shared_with_bot     # NEVER sent to frontend

# --- Single public port for REST + /internal-ws + /public-ws. Render (and
#     most PaaS hosts) sets PORT automatically — leave unset in production,
#     only needed for local dev. ---
PORT=8080

# --- CORS ---
FRONTEND_ORIGIN=https://yourdashboard.com
